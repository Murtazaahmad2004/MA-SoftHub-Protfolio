{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}